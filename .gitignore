# Agent Runtime Router — machine-local GENERATED state only.
# The installed skills (.agents/skills/agent-runtime-router*) and the adapter
# config (.agents/runtime-router/) are committed so a fresh checkout works;
# only these regenerated-per-machine artifacts stay ignored.
.agents/.agent-runtime-router/
.agents/runtime-router/harnesses/
.agents/runtime-router/adapters/*/kilo-resolved.json
.agents/runtime-router/adapters/*/discovery.json
.agents/runtime-router/adapters/*/discovery-last-report.json
.agents/runtime-router/adapters/*/profile.json
.agents/runtime-router/adapters/*/catalog-cache.json
.agents/runtime-router/active-harness.json
.agents/runtime-router/catalog-cache.json
.agents/runtime-router/.state.lock
