# Copy to .env and fill in per environment. No values here are secrets.

LOG_LEVEL=INFO

TOKEN_ISSUER=https://issuer.example.com
JWT_AUDIENCE=payments.example.com
JWKS_URL=https://issuer.example.com/.well-known/jwks.json
JWKS_TTL_SECONDS=300
JWKS_TIMEOUT_SECONDS=3

ALLOWED_ISSUERS=https://issuer.example.com,https://issuer-eu.example.com
REVOKED_KEY_IDS=kid-2023-legacy

# Path to the mounted RS256 private key PEM. Provided by the platform at
# deploy time; the file itself is never committed.
JWT_PRIVATE_KEY_PATH=/var/run/secrets/gateway/signing-key.pem
JWT_ACTIVE_KID=kid-2024-a

CLOCK_SKEW_LEEWAY_SECONDS=5
DEFAULT_TOKEN_LIFETIME_SECONDS=900
MAX_TOKEN_LIFETIME_SECONDS=3600
REFRESH_TOKEN_LIFETIME_SECONDS=604800

MESH_CLIENTS=checkout-api,billing-worker
