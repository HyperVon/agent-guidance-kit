Subject: [PATCH] Round proration in tenant timezone

Customer in a UTC+13 tenant was charged for an extra day on an upgrade.

---
 src/billing/rounding.py | 19 +++++++++++++++----
 tests/test_rounding.py  | 21 +++++++++++++++++++++
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/src/billing/rounding.py b/src/billing/rounding.py
index 44a1e05..b8f3c22 100644
--- a/src/billing/rounding.py
+++ b/src/billing/rounding.py
@@ -46,14 +46,29 @@ def proration_factor(
     return remaining / total
 
 
+def local_day_boundary(moment: datetime, tenant_timezone: str) -> datetime:
+    """Start of the local day containing `moment`, returned in UTC."""
+    tz = ZoneInfo(tenant_timezone)
+    local = moment.astimezone(tz)
+    start_local = local.replace(hour=0, minute=0, second=0, microsecond=0)
+    return start_local.astimezone(timezone.utc)
+
+
 def prorate_upgrade(
     amount_minor: int,
     currency: str,
     changed_at: datetime,
     period_start: datetime,
     period_end: datetime,
+    tenant_timezone: str = "UTC",
 ) -> int:
-    factor = proration_factor(changed_at, period_start, period_end)
+    boundary = local_day_boundary(changed_at, tenant_timezone)
+    factor = proration_factor(boundary, period_start, period_end)
     scaled = Decimal(amount_minor) * factor
     return int(scaled.quantize(Decimal(1), rounding=ROUND_HALF_UP))
