# Reusable, minimal evaluation image for the *execution* layer.
#
# Design goals (see docs/evaluations/isolation-protocol.md):
#   * Fresh, independent Kilo process per run (installed here, not on the host).
#   * No host secrets: this image contains NO ~/.gitconfig, NO ~/.ssh, NO
#     GH_TOKEN/GITHUB_TOKEN, and NO mounted Kilo auth store. Free models are used
#     through anonymous Kilo Gateway access (see RUNBOOK.md) — no credentials are
#     injected into the worker.
#   * Deterministic, non-attributable git identity so any git operations the
#     worker performs cannot leak the host author.
#   * The target skill guidance is NEVER baked into this image. The runner mounts
#     each independent writable task fixture at /work/task; target/placebo
#     treatment is created inside that workspace at .kilo/skills/<name>/ and
#     activated with --command <name>:skill. The baseline gets no .kilo/skills
#     treatment tree and no command.
FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git bash coreutils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install the Kilo CLI (Linux build) globally. Pin the exact version so that
# rebuilding the same eval source later never silently changes the worker runtime.
# This version must be kept in sync with the tested host Kilo (record it in the
# evidence). Bump it only as an explicit evaluation-runtime revision.
ARG KILO_CLI_VERSION=7.4.22
RUN npm install -g @kilocode/cli@${KILO_CLI_VERSION}

# Non-root eval user with an isolated HOME and a deterministic git identity.
RUN useradd --create-home --home-dir /home/eval eval
ENV HOME=/home/eval
RUN git config --file /home/eval/.gitconfig user.name "Eval Worker" \
    && git config --file /home/eval/.gitconfig user.email "eval-worker@example.invalid" \
    && git config --file /home/eval/.gitconfig init.defaultBranch main \
    && chown -R eval:eval /home/eval

# The runner mounts each fixture read-write at /work/task and invokes Kilo with
# --dir /work/task. Prompt/session output is collected from Kilo's JSON stream;
# there is no /work/input or /work/output protocol path.
RUN mkdir -p /work/task && chown -R eval:eval /work
WORKDIR /work/task
USER eval

ENTRYPOINT ["kilo"]
CMD ["--version"]
